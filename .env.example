# Google service account used to write waitlist signups to a Google Sheet.
# See README.md → "Google Sheets setup" for how to obtain these.

# From the service account's JSON key file:
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Keep the literal \n sequences (don't replace with real line breaks) and
# keep the whole value wrapped in quotes.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"

# The long ID in your sheet's URL, between /d/ and /edit:
# https://docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SHEETS_SPREADSHEET_ID=

# Name of the tab inside the spreadsheet that holds signups. Defaults to
# "Waitlist" if not set — must match your sheet's tab name exactly.
GOOGLE_SHEETS_TAB_NAME=Waitlist

# Resend sends the confirmation email after a successful signup.
# Create an API key at https://resend.com/api-keys and verify the domain used
# in RESEND_FROM_EMAIL at https://resend.com/domains.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL="EDMVerse <waitlist@yourdomain.com>"
